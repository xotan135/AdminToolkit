<Window x:Class="AdminToolkit.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Toolkit" Height="720" Width="1120" MinHeight="620" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,9"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource RaisedBackgroundBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Opacity" Value="1"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="10,7"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Padding" Value="8,6"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource RaisedBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GridLineBrush}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" Padding="28,22">
            <Grid>
                <StackPanel><TextBlock Text="Admin Toolkit" Foreground="{DynamicResource HeaderTextBrush}" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Remote Windows administration with visible, auditable results" Foreground="{DynamicResource HeaderMutedTextBrush}" FontSize="14" Margin="0,5,0,0"/></StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock Text="Dark mode" Foreground="{DynamicResource HeaderTextBrush}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                    <CheckBox x:Name="DarkModeToggle" VerticalAlignment="Center" Checked="DarkModeToggle_OnChanged" Unchecked="DarkModeToggle_OnChanged"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="9" Padding="20">
                <StackPanel>
                    <TextBlock Text="New job" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="COMPUTERS" Margin="0,22,0,7" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <TextBox x:Name="ComputerInput" Height="105" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="Enter computer names separated by commas, spaces, or new lines"/>
                    <TextBlock Text="Separate names with commas, spaces, or new lines. Duplicates are removed." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,6,0,0"/>
                    <TextBlock Text="ACTION" Margin="0,20,0,7" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <ComboBox x:Name="ActionInput" SelectionChanged="ActionInput_OnSelectionChanged">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}"/></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Margin="0,12,0,0" Padding="12" Background="{DynamicResource RaisedBackgroundBrush}" CornerRadius="6"><StackPanel><TextBlock x:Name="RiskText" FontWeight="SemiBold"/><TextBlock x:Name="ActionDescription" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0"/></StackPanel></Border>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="RunButton" Content="Run job" Click="RunButton_OnClick" Background="{DynamicResource AccentBrush}" Foreground="White" BorderBrush="{DynamicResource AccentBrush}"/>
                        <Button x:Name="CancelButton" Grid.Column="2" Content="Cancel" Click="CancelButton_OnClick" IsEnabled="False" Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource PanelBackgroundBrush}" CornerRadius="9" Padding="20">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="12"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="Job results" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/><TextBlock x:Name="SummaryText" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}" Text="No job has run yet"/></Grid>
                    <ProgressBar x:Name="JobProgress" Grid.Row="1" Height="5" Margin="0,16,0,16" Minimum="0" Maximum="1" Value="0" Foreground="{DynamicResource AccentBrush}"/>
                    <DataGrid x:Name="ResultsGrid" Grid.Row="2" SelectionChanged="ResultsGrid_OnSelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeaderWidth="0" HeadersVisibility="Column" Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" RowBackground="{DynamicResource PanelBackgroundBrush}" AlternatingRowBackground="{DynamicResource RaisedBackgroundBrush}">
                        <DataGrid.Columns><DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="1.3*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/><DataGridTextColumn Header="Result" Binding="{Binding Message}" Width="3*"/><DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="*"/></DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="4" Background="{DynamicResource RaisedBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Selected result output" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8"/>
                            <TextBox x:Name="DetailsOutput" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Text="Select a computer above to view update details and command output."/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource FooterBackgroundBrush}" Padding="24,10"><TextBlock x:Name="StatusText" Text="Ready" Foreground="{DynamicResource SecondaryTextBrush}"/></Border>
    </Grid>
</Window>
